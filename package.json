{
  "name": "stud",
  "displayName": "stud",
  "description": "Editor wrapper that runs a user-installed stud executable. It does not replace the CLI or call Jira, Linear, GitHub, or GitLab.",
  "icon": "resources/icon.png",
  "version": "0.0.3",
  "publisher": "studapart",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Studapart/stud-vsx-extension.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:stud.checkVersion",
    "onCommand:stud.validate",
    "onCommand:stud.openGlobalConfig",
    "onCommand:stud.openProjectConfig",
    "onCommand:stud.revealConfigLocations",
    "onCommand:stud.showConfig",
    "onCommand:stud.validateConfig",
    "onCommand:stud.showWorkItem",
    "onCommand:stud.showPullRequestComments",
    "onCommand:stud.sync",
    "onCommand:stud.commit",
    "onCommand:stud.push",
    "onCommand:stud.submit"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stud.checkVersion",
        "title": "Check Version",
        "category": "stud"
      },
      {
        "command": "stud.validate",
        "title": "Validate stud",
        "category": "stud"
      },
      {
        "command": "stud.openGlobalConfig",
        "title": "Open Global Config",
        "category": "stud"
      },
      {
        "command": "stud.openProjectConfig",
        "title": "Open Project Config",
        "category": "stud"
      },
      {
        "command": "stud.revealConfigLocations",
        "title": "Reveal Config Locations",
        "category": "stud"
      },
      {
        "command": "stud.showConfig",
        "title": "Show Config",
        "category": "stud"
      },
      {
        "command": "stud.validateConfig",
        "title": "Validate Config",
        "category": "stud"
      },
      {
        "command": "stud.showWorkItem",
        "title": "Show Work Item",
        "category": "stud"
      },
      {
        "command": "stud.showPullRequestComments",
        "title": "Show Pull Request Comments",
        "category": "stud"
      },
      {
        "command": "stud.sync",
        "title": "Sync",
        "category": "stud"
      },
      {
        "command": "stud.commit",
        "title": "Commit",
        "category": "stud"
      },
      {
        "command": "stud.push",
        "title": "Push",
        "category": "stud"
      },
      {
        "command": "stud.submit",
        "title": "Submit",
        "category": "stud"
      }
    ],
    "configuration": {
      "title": "stud",
      "properties": {
        "stud.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the user-installed `stud` executable. When this is empty and `stud.searchPath` is on, the extension looks on `PATH` and then in `~/.local/bin/stud`. Detection does not change this setting and does not install stud."
        },
        "stud.searchPath": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When `stud.executablePath` is empty, look for `stud` on `PATH` and then in `~/.local/bin/stud`. An explicit path is always used as given."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/*.test.js",
    "package": "scripts/package-vsix.sh"
  },
  "devDependencies": {
    "@types/node": "^18.19.80",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
